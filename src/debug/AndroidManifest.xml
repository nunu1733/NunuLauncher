<?xml version="1.0" encoding="utf-8"?><!--
  Issue #528: debug-only manifest overlay attaching the debug network
  security config. The main application tag declares no
  android:networkSecurityConfig attribute, so the merge needs no
  tools:replace. Release variants never see this overlay.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
