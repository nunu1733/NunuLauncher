>         val settingsUnavailablePresent = composeRule
>             .onAllNodesWithTag("usage_access_jit_settings_unavailable")
>             .fetchSemanticsNodes()
>             .isNotEmpty()
>         val semantics = runCatching { composeRule.onRoot().printToString() }
>             .getOrDefault("<semantics tree unavailable>")
